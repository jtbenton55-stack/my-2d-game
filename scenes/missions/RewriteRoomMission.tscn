offset_right = 25.0
offset_bottom = -5.0
text = "[NOTE]"
horizontal_alignment = 1

[node name="Note_LegalMemo" type="Area2D" parent="."]
position = Vector2(1100, 350)
script = ExtResource("2_note")
note_title = "Legal Memo"
note_text = "RE: Chain of Title Investigation\n\nWe've identified three potential 'fake' assignment documents in Sterling's files. The authentic chain-of-title should show:\n1. Original writer's guild registration (1987)\n2. Valid option agreement with writer consent\n3. Clean assignment to Sterling Pictures with proper consideration\n\nAll other variations are likely forgeries. - Mere"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Note_LegalMemo"]
shape = SubResource("CircleShape2D_area")

