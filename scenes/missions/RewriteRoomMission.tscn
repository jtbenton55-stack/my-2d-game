# === READABLE NOTES ===
[node name="Note_WriterMemoir" type="Area2D" parent="."]
position = Vector2(1350, 650)
script = ExtResource("2_note")
note_title = "Writer's Notes"
note_text = "Day 47. Sterling's people came again today. They want my screenplay - the one I've been developing for three years. Said they'd 'make me famous' if I sign over the rights. I refused. Tomorrow I'm hiding the original drafts in the file room. If something happens to me, the proof is in Cabinet B. -M.G."

[node name="CollisionShape2D" type="CollisionShape2D" parent="Note_WriterMemoir"]
shape = SubResource("CircleShape2D_area")

[node name="NoteVisual" type="ColorRect" parent="Note_WriterMemoir"]
