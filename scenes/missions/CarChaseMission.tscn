script = ExtResource("2_note")
note_title = "Family Wall"
note_text = "Photos from better days:\n\n- Dom and the crew at the old garage\n- Sunday dinners that lasted until midnight\n- The first time Bentley rode in the passenger seat\n\nScribbled below:\n'Family isn't about blood. It's about who's willing to sit in the car when the engine's smoking and the sirens are close.'"

