[node name="JinIntro" type="Node2D" parent="."]
position = Vector2(1250, 475)
script = ExtResource("2_dialogue")
dialogue_lines = Array[Dictionary]([{
"speaker": "Jin",
"text": "Speed is my domain. Move fast, think faster."
}, {
"speaker": "Kiro",
"text": "*nods from across the arena* Precision requires patience."
}, {
"speaker": "Bentley",
"text": "*sniffs the ground, finds a spot, sits down* Woof."
}, {
"speaker": "Jin",
"text": "He just... sat down. In the middle of our dramatic introduction."
}, {
"speaker": "You",
"text": "He's comfortable with himself."
}])

