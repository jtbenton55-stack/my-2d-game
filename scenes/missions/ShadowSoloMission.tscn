[node name="CompletionDialogue" type="Node2D" parent="."]
position = Vector2(800, 475)
script = ExtResource("2_dialogue")
dialogue_lines = Array[Dictionary]([{
"speaker": "Kiro",
"text": "You completed all three trials. Respect."
}, {
"speaker": "Jin",
"text": "Your technique... it's unconventional, but effective."
}, {
"speaker": "Bentley",
"text": "*gets up, stretches, walks away without looking back* ...Woof."
}, {
"speaker": "Kiro",
"text": "Your dog is impossible."
}, {
"speaker": "You",
"text": "He's consistent. That's what matters."
}])

