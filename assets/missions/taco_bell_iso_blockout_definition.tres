[resource]
script = ExtResource("1_def")
mission_id = "taco_bell_drop"
display_name = "The Taco Bell Drop"
description = "Iso blockout prototype for the delivery-route heist. Existing orthogonal TacoBellMission remains untouched."
genre_feel = "Street logistics heist"
player_mindset = "After-hours infiltration, scent reading, and tight extraction."
signature_mechanic = "Bentley scent trail plus garage keypad placeholder."
signature_emotion = "Paranoia plus Louis/Bentley competence."
zones = Array[Resource]([SubResource("Zone_market"), SubResource("Zone_yard"), SubResource("Zone_garage")])
primary_objectives = Array[Resource]([SubResource("Obj_meet"), SubResource("Obj_scent"), SubResource("Obj_bag")])
optional_objectives = Array[Resource]([SubResource("Obj_optional_decoy")])
access_items = Array[String](["delivery_badge", "garage_code"])
puzzle_gates = Array[Resource]([SubResource("Gate_garage")])
unique_mechanics = Array[String](["bentley_scent_trail", "alternate_keypad_code", "decoy_bag"])
enemies = Array[Resource]([SubResource("Spawn_player"), SubResource("Spawn_guard")])
stealth_opportunities = Array[String](["Avoid yard guard route.", "Use scent trail to skip decoy bag."])
combat_opportunities = Array[String](["Optional yard guard pressure placeholder."])
collectibles = Array[Resource]([SubResource("Col_polaroid"), SubResource("Col_glow"), SubResource("Col_icon"), SubResource("Col_bag1"), SubResource("Col_bag2"), SubResource("Col_bag3")])
evidence_clues = Array[Resource]([SubResource("Clue_delivery")])
scheme_card_rewards = Array[Resource]([SubResource("Reward_louis")])
cutscenes = Array[Resource]([SubResource("Cut_intro")])
live_restart_mutations = Array[Resource]([SubResource("Mut_code"), SubResource("Mut_collectible")])
final_tower_connections = Array[String](["Sterling Tower delivery entrance", "Loading dock logistics"])
required_prior_clues_or_rewards = Array[String]([])
routes = Array[Resource]([SubResource("Route_main")])
art_notes = "Do not paint final art into GameplayRoot. Later Monogon cyberpunk art belongs under ArtRoot only."
implementation_status = "phase_1_sample_blockout"
