note_title = "Stage Manager's Notes"
note_text = "Song order for tonight:\n1. Open with intimacy\n2. Keep it light (bathroom humor always works)\n3. Kids love the Wee-Woo\n4. Dental blues for the working crowd\n5. Two Letters Away - the ballad\n6. Close with Raincoat for a Crime Dog - crowd goes wild"

