[node name="LouisDialogueTrigger" type="Area2D" parent="." unique_id=1135312868]
script = ExtResource("7_dialogue")
dialogue_lines = Array[Dictionary]([{
"speaker": "Louis",
"text": "I deliver tacos, secrets, and occasionally fugitives. Tonight, someone stole all three."
}, {
"speaker": "Louis",
"text": "Sterling's crew took the bag toward the loading yard — Bentley's already reading the receipt like a subpoena."
}, {
"speaker": "Bentley",
"text": "*sniffs the receipt, stares into the alley — one tiny bark*"
}, {
"speaker": "Louis",
"text": "Dumpster has my scribble. Three scent trails split from Delivery Alley — only one is real."
}])

