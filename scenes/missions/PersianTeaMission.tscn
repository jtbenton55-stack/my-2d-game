dialogue_lines = Array[Dictionary]([{
"speaker": "JC",
"text": "Ah, you made it! Come, the tea is almost ready."
}, {
"speaker": "Bentley",
"text": "*sniffs the air appreciatively*"
}, {
"speaker": "JC",
"text": "Your dog has good taste. Now, to unlock the hidden drawer, you must brew the blend my grandmother taught me."
}, {
"speaker": "JC",
"text": "Find sour cherry, cardamom, and saffron from the garden. The watercolor painting holds the arrangement clue."
}])

