[node name="KiroIntro" type="Node2D" parent="."]
position = Vector2(350, 475)
script = ExtResource("2_dialogue")
dialogue_lines = Array[Dictionary]([{
"speaker": "Kiro",
"text": "So you're the one who thinks they can handle our trials."
}, {
"speaker": "Jin",
"text": "*appears from shadows* Most don't make it past the first."
}, {
"speaker": "Bentley",
"text": "*yawns loudly, unimpressed* ...Woof."
}, {
"speaker": "Kiro",
"text": "Your dog has no respect for the art of combat."
}, {
"speaker": "You",
"text": "Bentley has opinions. Let's begin."
}])

